<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.paf91.nifi</groupId>
    <artifactId>nifi-opcua-processor-parent</artifactId>
    <version>1.0.5-SNAPSHOT</version>
    <relativePath>parent/pom.xml</relativePath>
  </parent>
  <artifactId>nifi-opcua-processors</artifactId>
  <name>OPC UA Processors for NiFi 1</name>
  <properties>
    <milo.version>0.6.16</milo.version>
    <milo.source>milo06</milo.source>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.milo</groupId>
      <artifactId>sdk-client</artifactId>
      <version>${milo.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.milo</groupId>
      <artifactId>sdk-server</artifactId>
      <version>${milo.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>publication</id>
      <dependencies>
        <!-- Preserve the client stack when flattening removes the test SDK server. -->
        <dependency>
          <groupId>org.eclipse.milo</groupId>
          <artifactId>stack-core</artifactId>
          <version>${milo.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
